@model List<PersonRegistrationMvc.ViewModels.ArchivedItemViewModel>
@inject Microsoft.Extensions.Localization.IStringLocalizer<PersonRegistrationMvc.SharedResource> Localizer

<h2>@Localizer["ArchivedItemsTitle"]</h2>

<table class="table table-striped table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>@Localizer["TypeColumn"]</th>
            <th>@Localizer["NameColumn"]</th>
            <th>@Localizer["DetailsColumn"]</th>
            <th class="text-center">@Localizer["ArchivedDateColumn"]</th>
            <th class="text-center">@Localizer["ActionsColumn"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@(item.ItemType == "Person" ? Localizer["PersonTypeLabel"] : Localizer["BookTypeLabel"])</td>
                <td>@item.DisplayName</td>
                <td>@item.Details</td>
                <td class="text-center">@(item.ArchivedDate?.ToShortDateString() ?? "-")</td>
                <td class="text-center">
                    @if (item.ItemType == "Person")
                    {
                        <form asp-controller="Person" asp-action="Restore" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-success">@Localizer["RestoreButton"]</button>
                        </form>
                    }
                    else
                    {
                        <form asp-controller="Book" asp-action="Restore" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-success">@Localizer["RestoreButton"]</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>