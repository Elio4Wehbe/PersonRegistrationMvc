@model List<PersonRegistrationMvc.ViewModels.PersonListViewModel>
@inject Microsoft.Extensions.Localization.IStringLocalizer<PersonRegistrationMvc.SharedResource> Localizer

<button type="button" class="btn btn-primary mb-3" data-bs-toggle="modal" data-bs-target="#registerPersonModal">
    @Localizer["RegisterPersonButton"]
</button>

<div class="modal fade" id="registerPersonModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Localizer["RegisterNewPersonTitle"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Person" asp-action="Register" method="post">
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label>@Localizer["FullNameLabel"]</label>
                        <input name="FullName" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label>@Localizer["AgeLabel"]</label>
                        <input name="Age" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label>@Localizer["GenderLabel"]</label>
                        <select name="Gender" class="form-control">
                            <option value="Male">@Localizer["MaleLabel"]</option>
                            <option value="Female">@Localizer["FemaleLabel"]</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label>@Localizer["MajorLabel"]</label>
                        <input name="Major" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["CancelButton"]</button>
                    <button type="submit" class="btn btn-primary">@Localizer["SubmitButton"]</button>
                </div>
            </form>
        </div>
    </div>
</div>
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}
<h2>@Localizer["RegisteredPersonsTitle"]</h2>

<input type="text" id="personSearchBox" class="form-control mb-3" style="max-width:300px;" placeholder="@Localizer["SearchPersonsPlaceholder"]" />

<table class="table table-striped table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>@Localizer["FullNameLabel"]</th>
            <th class="text-center">@Localizer["AgeLabel"]</th>
            <th class="text-center">@Localizer["GenderLabel"]</th>
            <th>@Localizer["MajorLabel"]</th>
            <th class="text-center">@Localizer["ActionsColumn"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var person in Model)
        {
            <tr>
                <td>@person.FullName</td>
                <td class="text-center">@person.Age</td>
                <td class="text-center">@(person.Gender == "Male" ? Localizer["MaleLabel"] : Localizer["FemaleLabel"])</td>
                <td class="text-center">@person.Major</td>
                <td class="text-center">
                    <button type="button" class="btn btn-sm btn-info" onclick="showPersonDetails(@person.PersonId)">@Localizer["DetailsButton"]</button>
                    <a asp-controller="Person" asp-action="Edit" asp-route-id="@person.PersonId" class="btn btn-sm btn-primary">@Localizer["EditButton"]</a>
                    <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@person.PersonId">
                        @Localizer["DeleteButton"]
                    </button>
                    <div class="modal fade" id="deleteModal-@person.PersonId" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">@Localizer["ConfirmDeleteTitle"]</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    @Html.Raw(string.Format(Localizer["DeleteConfirmText"].Value, $"<strong>{person.FullName}</strong>"))
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["CancelButton"]</button>
                                    <form asp-controller="Person" asp-action="DeleteConfirmed" method="post" style="display:inline;">
                                        <input type="hidden" name="id" value="@person.PersonId" />
                                        <button type="submit" class="btn btn-danger">@Localizer["YesDeleteButton"]</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="modal fade" id="personDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="personDetailsTitle">@Localizer["PersonDetailsTitle"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p><strong>@Localizer["AgeLabel"]:</strong> <span id="personDetailsAge"></span></p>
                <p><strong>@Localizer["GenderLabel"]:</strong> <span id="personDetailsGender"></span></p>
                <p><strong>@Localizer["MajorLabel"]:</strong> <span id="personDetailsMajor"></span></p>
                <p><strong>@Localizer["ActiveBorrowsLabel"]:</strong> <span id="personDetailsBorrowCount"></span></p>
                <p><strong>@Localizer["CurrentlyBorrowedLabel"]:</strong> <span id="personDetailsBorrowedBooks"></span></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const noneText = '@Localizer["NoneLabel"]';

        document.getElementById('personSearchBox').addEventListener('keyup', function() {
            var filter = this.value.toLowerCase();
            document.querySelectorAll('table tbody tr').forEach(function(row) {
                row.style.display = row.textContent.toLowerCase().includes(filter) ? '' : 'none';
            });
        });

        function showPersonDetails(personId) {
            fetch('/Person/GetPersonDetails?id=' + personId)
                .then(response => response.json())
                .then(person => {
                    document.getElementById('personDetailsTitle').textContent = person.fullName;
                    document.getElementById('personDetailsAge').textContent = person.age;
                    document.getElementById('personDetailsGender').textContent = person.gender;
                    document.getElementById('personDetailsMajor').textContent = person.major;
                    document.getElementById('personDetailsBorrowCount').textContent = person.activeBorrowCount;
                    document.getElementById('personDetailsBorrowedBooks').textContent = person.currentlyBorrowedBooks.length
                        ? person.currentlyBorrowedBooks.join(', ')
                        : noneText;
                    new bootstrap.Modal(document.getElementById('personDetailsModal')).show();
                });
        }
    </script>
}