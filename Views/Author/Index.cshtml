@model List<PersonRegistrationMvc.ViewModels.AuthorListViewModel>
@inject Microsoft.Extensions.Localization.IStringLocalizer<PersonRegistrationMvc.SharedResource> Localizer

<h2>@Localizer["AuthorsNav"]</h2>
@if (User.IsInRole("Admin"))
{
    <a asp-controller="Author" asp-action="Add" class="btn btn-primary mb-3">@Localizer["AddAuthorButton"]</a>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<input type="text" id="authorSearchBox" class="form-control mb-3" style="max-width:300px;" placeholder="@Localizer["SearchAuthorsPlaceholder"]" />

<table class="table table-striped table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>@Localizer["NameColumn"]</th>
            <th class="text-center">@Localizer["ActionsColumn"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var author in Model)
        {
            <tr>
                <td>@author.Name</td>

                <td class="text-center">
                    <button type="button" class="btn btn-sm btn-info" onclick="showAuthorDetails(@author.AuthorId)">@Localizer["DetailsButton"]</button>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Author" asp-action="Edit" asp-route-id="@author.AuthorId" class="btn btn-sm btn-primary">@Localizer["EditButton"]</a>
                        <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@author.AuthorId">
                            @Localizer["DeleteButton"]
                        </button>
                        <div class="modal fade" id="deleteModal-@author.AuthorId" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">@Localizer["ConfirmDeleteTitle"]</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        @Html.Raw(string.Format(Localizer["DeleteConfirmText"].Value, $"<strong>{author.Name}</strong>"))
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["CancelButton"]</button>
                                        <form asp-controller="Author" asp-action="DeleteConfirmed" method="post" style="display:inline;">
                                            <input type="hidden" name="id" value="@author.AuthorId" />
                                            <button type="submit" class="btn btn-danger">@Localizer["YesDeleteButton"]</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="modal fade" id="authorDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="authorDetailsTitle">@Localizer["AuthorDetailsTitle"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p><strong>@Localizer["BooksNav"]:</strong> <span id="authorDetailsBooks"></span></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const noBooksText = '@Localizer["NoBooksYet"]';

        document.getElementById('authorSearchBox').addEventListener('keyup', function() {
            var filter = this.value.toLowerCase();
            document.querySelectorAll('table tbody tr').forEach(function(row) {
                row.style.display = row.textContent.toLowerCase().includes(filter) ? '' : 'none';
            });
        });

        function showAuthorDetails(authorId) {
            fetch('/Author/GetAuthorDetails?id=' + authorId)
                .then(response => response.json())
                .then(author => {
                    document.getElementById('authorDetailsTitle').textContent = author.name;
                    document.getElementById('authorDetailsBooks').textContent = author.bookTitles.length
                        ? author.bookTitles.join(', ')
                        : noBooksText;
                    new bootstrap.Modal(document.getElementById('authorDetailsModal')).show();
                });
        }
    </script>
}