@using System.Globalization
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" dir="@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PersonRegistrationMvc</title>
    <script type="importmap"></script>
    @if (CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar")
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PersonRegistrationMvc.styles.css" asp-append-version="true" />
</head>
<body>
    @inject Microsoft.Extensions.Localization.IStringLocalizer<PersonRegistrationMvc.SharedResource> Localizer
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">PersonRegistrationMvc</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Dashboard" asp-action="Index">@Localizer["DashboardNav"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Borrow" asp-action="Index">@Localizer["MyBorrowsNav"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Borrow" asp-action="Borrow">@Localizer["BorrowABookNav"]</a>
                            </li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown">@Localizer["ManageNav"]</a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Person" asp-action="Index">@Localizer["PersonsNav"]</a></li>
                                        <li><a class="dropdown-item" asp-controller="Author" asp-action="Index">@Localizer["AuthorsNav"]</a></li>
                                        <li><a class="dropdown-item" asp-controller="Category" asp-action="Index">@Localizer["CategoriesNav"]</a></li>
                                        <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Archived">@Localizer["ArchivedNav"]</a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item" asp-controller="Account" asp-action="Index">@Localizer["ManageUsersNav"]</a></li>
                                        <li><a class="dropdown-item" asp-controller="Reports" asp-action="Index">@Localizer["ReportsNav"]</a></li>
                                    </ul>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Book" asp-action="Index">@Localizer["BooksNav"]</a>
                            </li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="AuditLog" asp-action="Index">@Localizer["AuditLogNav"]</a>
                                </li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-dark">@string.Format(Localizer["HelloGreeting"], User.FindFirst("FullName")?.Value ?? User.Identity.Name)</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-link nav-link text-dark">@Localizer["LogoutButton"]</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">@Localizer["LoginNav"]</a>
                            </li>
                        }
                        <li class="nav-item d-flex align-items-center">
                            <form asp-controller="Culture" asp-action="SetLanguage" asp-route-returnUrl="@Context.Request.Path" method="post" class="d-flex">
                                <button type="submit" name="culture" value="en" class="btn btn-sm btn-link text-dark">EN</button>
                                <button type="submit" name="culture" value="ar" class="btn btn-sm btn-link text-dark">AR</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - PersonRegistrationMvc
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>