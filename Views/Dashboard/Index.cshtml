@model PersonRegistrationMvc.ViewModels.DashboardViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<PersonRegistrationMvc.SharedResource> Localizer

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<h2>@Localizer["DashboardNav"]</h2>

<form asp-controller="Dashboard" asp-action="Index" method="get" class="mb-4">
    <div class="input-group" style="max-width: 400px;">
        <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="@Localizer["SearchPlaceholder"]" />
        <button type="submit" class="btn btn-primary">@Localizer["SearchButton"]</button>
    </div>
</form>

@if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
{
    <h4>@string.Format(Localizer["ResultsForLabel"], Model.SearchTerm)</h4>

    @if (User.IsInRole("Admin") && Model.MatchingPersons.Any())
    {
        <h5>@Localizer["PersonsNav"]</h5>
        <ul class="list-group mb-3">
            @foreach (var p in Model.MatchingPersons)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    @p.FullName (@p.Major)
                    <a asp-controller="Person" asp-action="Edit" asp-route-id="@p.PersonId" class="btn btn-sm btn-primary">@Localizer["EditButton"]</a>
                </li>
            }
        </ul>
    }
    @if (Model.MatchingBooks.Any())
    {
        <h5>@Localizer["BooksNav"]</h5>
        <ul class="list-group mb-3">
            @foreach (var b in Model.MatchingBooks)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    @b.Title (@b.CategoryName)
                    <a asp-controller="Book" asp-action="Edit" asp-route-id="@b.BookId" class="btn btn-sm btn-primary">@Localizer["EditButton"]</a>
                </li>
            }
        </ul>
    }
    @if (Model.MatchingAuthors.Any())
    {
        <h5>@Localizer["AuthorsNav"]</h5>
        <ul class="list-group mb-3">
            @foreach (var a in Model.MatchingAuthors)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    @a.Name
                    <a asp-controller="Author" asp-action="Edit" asp-route-id="@a.AuthorId" class="btn btn-sm btn-primary">@Localizer["EditButton"]</a>
                </li>
            }
        </ul>
    }
    @if (Model.MatchingCategories.Any())
    {
        <h5>@Localizer["CategoriesNav"]</h5>
        <ul class="list-group mb-3">
            @foreach (var c in Model.MatchingCategories)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    @c.Name
                    <a asp-controller="Category" asp-action="Edit" asp-route-id="@c.CategoryId" class="btn btn-sm btn-primary">@Localizer["EditButton"]</a>
                </li>
            }
        </ul>
    }
    @if (!Model.MatchingPersons.Any() && !Model.MatchingBooks.Any() && !Model.MatchingAuthors.Any() && !Model.MatchingCategories.Any())
    {
        <p>@Localizer["NoMatchesFound"]</p>
    }
}

<div class="row mt-4">
    @if (User.IsInRole("Admin"))
    {
        <div class="col-md-3 mb-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">@Localizer["PersonsNav"]</h5>
                    <p class="display-6">@Model.PersonCount</p>
                    <a asp-controller="Person" asp-action="Index" class="btn btn-sm btn-outline-primary">@Localizer["ViewAllButton"]</a>
                </div>
            </div>
        </div>
    }
    <div class="col-md-3 mb-3">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">@Localizer["BooksNav"]</h5>
                <p class="display-6">@Model.BookCount</p>
                <a asp-controller="Book" asp-action="Index" class="btn btn-sm btn-outline-primary">@Localizer["ViewAllButton"]</a>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">@Localizer["AuthorsNav"]</h5>
                <p class="display-6">@Model.AuthorCount</p>
                <a asp-controller="Author" asp-action="Index" class="btn btn-sm btn-outline-primary">@Localizer["ViewAllButton"]</a>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">@Localizer["CategoriesNav"]</h5>
                <p class="display-6">@Model.CategoryCount</p>
                <a asp-controller="Category" asp-action="Index" class="btn btn-sm btn-outline-primary">@Localizer["ViewAllButton"]</a>
            </div>
        </div>
    </div>
</div>

@if (User.IsInRole("Admin"))
{
    <a asp-controller="Dashboard" asp-action="Archived" class="btn btn-secondary mt-2">@Localizer["ViewArchivedItemsButton"]</a>
}