@model List<PersonRegistrationMvc.ViewModels.BorrowListViewModel>
@inject Microsoft.Extensions.Localization.IStringLocalizer<PersonRegistrationMvc.SharedResource> Localizer

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<h2>@Localizer["BorrowedBooksTitle"]</h2>

<table class="table table-striped table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>@Localizer["PersonLabel"]</th>
            <th>@Localizer["BookTypeLabel"]</th>
            <th class="text-center">@Localizer["BorrowDateColumn"]</th>
            <th class="text-center">@Localizer["DueDateColumn"]</th>
            <th class="text-center">@Localizer["StatusColumn"]</th>
            <th class="text-center">@Localizer["ActionsColumn"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var borrow in Model)
        {
            <tr>
                <td>@borrow.PersonName</td>
                <td>@borrow.BookTitle</td>
                <td class="text-center">@borrow.BorrowDate.ToShortDateString()</td>
                <td class="text-center">@borrow.DueDate.ToShortDateString()</td>
                <td class="text-center">
                    @if (borrow.ReturnDate != null)
                    {
                        <span class="badge bg-success">@Localizer["ReturnedStatus"]</span>
                    }
                    else if (borrow.IsOverdue)
                    {
                        <span class="badge bg-danger">@Localizer["OverdueStatus"]</span>
                    }
                    else
                    {
                        <span class="badge bg-warning">@Localizer["ActiveStatus"]</span>
                    }
                </td>
                <td class="text-center">
                    @if (borrow.ReturnDate == null)
                    {
                        <form asp-controller="Borrow" asp-action="Return" method="post"
                              onsubmit="return confirm('@Localizer["ReturnConfirmText"]');" style="display:inline;">
                            <input type="hidden" name="id" value="@borrow.BorrowId" />
                            <button type="submit" class="btn btn-sm btn-success">@Localizer["ReturnButton"]</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>