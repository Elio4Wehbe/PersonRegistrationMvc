@model List<PersonRegistrationMvc.ViewModels.PersonListViewModel>

<h2>Archived Persons</h2>

<table class="table table-striped table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Full Name</th>
            <th class="text-center">Age</th>
            <th class="text-center">Gender</th>
            <th>Major</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var person in Model)
        {
            <tr>
                <td>@person.FullName</td>
                <td class="text-center">@person.Age</td>
                <td class="text-center">@person.Gender</td>
                <td class="text-center">@person.Major</td>
                <td class="text-center">
                    <form asp-controller="Person" asp-action="Restore" method="post" style="display:inline;">
                        <input type="hidden" name="id" value="@person.PersonId" />
                        <button type="submit" class="btn btn-sm btn-success">Restore</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>