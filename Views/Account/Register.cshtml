@model PersonRegistrationMvc.ViewModels.RegisterViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<PersonRegistrationMvc.SharedResource> Localizer

<h2>@Localizer["CreateUserTitle"]</h2>

<form asp-controller="Account" asp-action="Register" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="FullName" class="form-label">@Localizer["FullNameLabel"]</label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">@Localizer["EmailLabel"]</label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label">@Localizer["PasswordLabel"]</label>
        <input asp-for="Password" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="RoleId" class="form-label">@Localizer["RoleLabel"]</label>
        <select asp-for="RoleId" asp-items="Model.RoleOptions" class="form-select" id="roleSelect">
            <option value="">@Localizer["SelectRoleOption"]</option>
        </select>
        <span asp-validation-for="RoleId" class="text-danger"></span>
    </div>

    <div id="personSection" style="display:none;">
        <div class="mb-3">
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="LinkExistingPerson" id="createNewPerson" value="false" checked>
                <label class="form-check-label" for="createNewPerson">@Localizer["CreateNewMemberOption"]</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="LinkExistingPerson" id="linkExisting" value="true">
                <label class="form-check-label" for="linkExisting">@Localizer["LinkExistingMemberOption"]</label>
            </div>
        </div>

        <div id="newPersonFields">
            <div class="mb-3">
                <label asp-for="Age" class="form-label">@Localizer["AgeLabel"]</label>
                <input asp-for="Age" class="form-control" />
                <span asp-validation-for="Age" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Gender" class="form-label">@Localizer["GenderLabel"]</label>
                <select asp-for="Gender" asp-items="Html.GetEnumSelectList<PersonRegistrationMvc.Models.Gender>()" class="form-select"></select>
                <span asp-validation-for="Gender" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Major" class="form-label">@Localizer["MajorLabel"]</label>
                <input asp-for="Major" class="form-control" />
                <span asp-validation-for="Major" class="text-danger"></span>
            </div>
        </div>

        <div id="existingPersonField" style="display:none;">
            <div class="mb-3">
                <label asp-for="PersonId" class="form-label">@Localizer["LibraryMemberLabel"]</label>
                <select asp-for="PersonId" asp-items="Model.PersonOptions" class="form-select">
                    <option value="">@Localizer["SelectPersonOption"]</option>
                </select>
                <span asp-validation-for="PersonId" class="text-danger"></span>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">@Localizer["CreateUserButton"]</button>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function updateRoleUI() {
            var roleText = document.getElementById('roleSelect').selectedOptions[0]?.text;
            document.getElementById('personSection').style.display = roleText === 'User' ? 'block' : 'none';
        }
        document.getElementById('roleSelect').addEventListener('change', updateRoleUI);
        updateRoleUI();

        document.querySelectorAll('input[name="LinkExistingPerson"]').forEach(function(radio) {
            radio.addEventListener('change', function() {
                var linking = document.getElementById('linkExisting').checked;
                document.getElementById('newPersonFields').style.display = linking ? 'none' : 'block';
                document.getElementById('existingPersonField').style.display = linking ? 'block' : 'none';
            });
        });
    </script>
}