@model List<PersonRegistrationMvc.ViewModels.UserListViewModel>
@inject Microsoft.Extensions.Localization.IStringLocalizer<PersonRegistrationMvc.SharedResource> Localizer

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<h2>@Localizer["ManageUsersNav"]</h2>
<a asp-controller="Account" asp-action="Register" class="btn btn-primary mb-3">@Localizer["CreateUserButton"]</a>

<table class="table table-striped table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>@Localizer["FullNameLabel"]</th>
            <th>@Localizer["EmailLabel"]</th>
            <th class="text-center">@Localizer["RoleLabel"]</th>
            <th class="text-center">@Localizer["ActionsColumn"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.FullName</td>
                <td>@user.Email</td>
                <td class="text-center">@user.Role</td>
                <td class="text-center">
                    <a asp-controller="Account" asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-primary">@Localizer["EditButton"]</a>
                    <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@user.Id">
                        @Localizer["DeleteButton"]
                    </button>

                    <div class="modal fade" id="deleteModal-@user.Id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">@Localizer["ConfirmDeleteTitle"]</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    @Html.Raw(string.Format(Localizer["DeleteUserConfirmText"].Value, $"<strong>{user.FullName}</strong>"))
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["CancelButton"]</button>
                                    <form asp-controller="Account" asp-action="Delete" method="post" style="display:inline;">
                                        <input type="hidden" name="id" value="@user.Id" />
                                        <button type="submit" class="btn btn-danger">@Localizer["YesDeleteButton"]</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>