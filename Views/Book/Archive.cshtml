@model List<PersonRegistrationMvc.ViewModels.BookListViewModel>

<h2>Archived Books</h2>

<table class="table table-striped table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Title</th>
            <th class="text-center">Category</th>
            <th class="text-center">Published Year</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>@book.Title</td>
                <td class="text-center">@book.CategoryName</td>
                <td class="text-center">@book.PublishedYear</td>
                <td class="text-center">
                    <form asp-controller="Book" asp-action="Restore" method="post" style="display:inline;">
                        <input type="hidden" name="id" value="@book.BookId" />
                        <button type="submit" class="btn btn-sm btn-success">Restore</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>