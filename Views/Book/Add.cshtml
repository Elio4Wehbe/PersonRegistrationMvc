@model PersonRegistrationMvc.ViewModels.BookAddViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<PersonRegistrationMvc.SharedResource> Localizer

<h2>@Localizer["AddBookButton"]</h2>

<form asp-controller="Book" asp-action="Add" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label>@Localizer["TitleLabel"]</label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>@Localizer["CoverImageUrlLabel"]</label>
        <input asp-for="CoverImageUrl" class="form-control" placeholder="https://..." />
    </div>

    <div class="mb-3">
        <label>@Localizer["CategoryLabel"]</label>
        <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="form-control">
            <option value="">@Localizer["SelectCategoryOption"]</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>@Localizer["PublishedYearLabel"]</label>
        <input asp-for="PublishedYear" class="form-control" />
        <span asp-validation-for="PublishedYear" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>@Localizer["TotalCopiesLabel"]</label>
        <input asp-for="TotalCopies" class="form-control" />
        <span asp-validation-for="TotalCopies" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>@Localizer["AvailableCopiesLabel"]</label>
        <input asp-for="AvailableCopies" class="form-control" />
        <span asp-validation-for="AvailableCopies" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>@Localizer["AuthorsNav"]</label>
        <div class="border rounded p-2">
            @foreach (var author in Model.AuthorOptions)
            {
                <div class="form-check">
                    <input type="checkbox" class="form-check-input"
                           name="SelectedAuthorIds"
                           value="@author.Value"
                           id="author_@author.Value"
                           checked="@(Model.SelectedAuthorIds.Contains(int.Parse(author.Value)))" />
                    <label class="form-check-label" for="author_@author.Value">@author.Text</label>
                </div>
            }
        </div>
    </div>

    <button type="submit" class="btn btn-primary">@Localizer["AddBookButton"]</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}