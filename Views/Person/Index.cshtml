@model List<PersonRegistrationMvc.ViewModels.PersonListViewModel>
<button type="button" class="btn btn-primary mb-3" data-bs-toggle="modal" data-bs-target="#registerPersonModal">
    Register Person
</button>

<div class="modal fade" id="registerPersonModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Register a New Person</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Person" asp-action="Register" method="post">
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label>Full Name</label>
                        <input name="FullName" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label>Age</label>
                        <input name="Age" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label>Gender</label>
                        <select name="Gender" class="form-control">
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label>Major</label>
                        <input name="Major" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Register</button>
                </div>
            </form>
        </div>
    </div>
</div>
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}
<h2>Registered Persons</h2>

<input type="text" id="personSearchBox" class="form-control mb-3" style="max-width:300px;" placeholder="Search persons..." />

<table class="table table-striped table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Full Name</th>
            <th class="text-center">Age</th>
            <th class="text-center">Gender</th>
            <th>Major</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var person in Model)
        {
            <tr>
                <td>@person.FullName</td>
                <td class="text-center">@person.Age</td>
                <td class="text-center">@person.Gender</td>
                <td class="text-center">@person.Major</td>
                <td class="text-center">
                    <a asp-controller="Person" asp-action="Edit" asp-route-id="@person.PersonId" class="btn btn-sm btn-primary">Edit</a>
                    <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@person.PersonId">
                        Delete
                    </button>
                    <div class="modal fade" id="deleteModal-@person.PersonId" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">Confirm Delete</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    Are you sure you want to delete <strong>@person.FullName</strong>?
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <form asp-controller="Person" asp-action="DeleteConfirmed" method="post" style="display:inline;">
                                        <input type="hidden" name="id" value="@person.PersonId" />
                                        <button type="submit" class="btn btn-danger">Yes, Delete</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        document.getElementById('personSearchBox').addEventListener('keyup', function() {
            var filter = this.value.toLowerCase();
            document.querySelectorAll('table tbody tr').forEach(function(row) {
                row.style.display = row.textContent.toLowerCase().includes(filter) ? '' : 'none';
            });
        });
    </script>
}