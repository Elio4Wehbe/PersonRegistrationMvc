@model PersonRegistrationMvc.ViewModels.AuthorAddViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<PersonRegistrationMvc.SharedResource> Localizer

<h2>@Localizer["AddAuthorButton"]</h2>

<form asp-controller="Author" asp-action="Add" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label>@Localizer["NameColumn"]</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">@Localizer["AddAuthorButton"]</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}