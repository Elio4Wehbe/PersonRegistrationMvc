@model List<PersonRegistrationMvc.ViewModels.AuditLogEntryViewModel>
@inject Microsoft.Extensions.Localization.IStringLocalizer<PersonRegistrationMvc.SharedResource> Localizer

<h2>@Localizer["AuditLogTitle"]</h2>

<input type="text" id="auditSearchBox" class="form-control mb-3" style="max-width:300px;" placeholder="@Localizer["SearchAuditLogPlaceholder"]" />

<table class="table table-striped table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>@Localizer["EntityTypeColumn"]</th>
            <th>@Localizer["ItemColumn"]</th>
            <th class="text-center">@Localizer["CreatedByColumn"]</th>
            <th class="text-center">@Localizer["CreatedAtColumn"]</th>
            <th class="text-center">@Localizer["UpdatedByColumn"]</th>
            <th class="text-center">@Localizer["UpdatedAtColumn"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var entry in Model)
        {
            <tr>
                <td>
                    @{
                        var typeLabel = entry.EntityType switch
                        {
                            "Person" => Localizer["PersonTypeLabel"],
                            "Book" => Localizer["BookTypeLabel"],
                            "Author" => Localizer["AuthorTypeLabel"],
                            "Category" => Localizer["CategoryLabel"],
                            "Borrow" => Localizer["BorrowTypeLabel"],
                            _ => Localizer["UserTypeLabel"]
                        };
                    }
                    @typeLabel
                </td>
                <td>@entry.EntityName</td>
                <td class="text-center">@(string.IsNullOrEmpty(entry.CreatedBy) ? "—" : entry.CreatedBy)</td>
                <td class="text-center">@(entry.CreatedAt == default(DateTime) ? Localizer["PreExistingRecord"] : entry.CreatedAt.ToString("g"))</td>
                <td class="text-center">@(entry.UpdatedBy ?? "—")</td>
                <td class="text-center">@(entry.UpdatedAt.HasValue ? entry.UpdatedAt.Value.ToString("g") : "—")</td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        document.getElementById('auditSearchBox').addEventListener('keyup', function() {
            var filter = this.value.toLowerCase();
            document.querySelectorAll('table tbody tr').forEach(function(row) {
                row.style.display = row.textContent.toLowerCase().includes(filter) ? '' : 'none';
            });
        });
    </script>
}
