@model PersonRegistrationMvc.ViewModels.BookEditViewModel

<h2>Edit Book</h2>

<form asp-controller="Book" asp-action="Edit" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="BookId" />

    <div class="mb-3">
        <label>Title</label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label>Category</label>
        <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="form-control">
            <option value="">-- Select Category --</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>


    <div class="mb-3">
        <label>Published Year</label>
        <input asp-for="PublishedYear" class="form-control" />
        <span asp-validation-for="PublishedYear" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Total Copies</label>
        <input asp-for="TotalCopies" class="form-control" />
        <span asp-validation-for="TotalCopies" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Available Copies</label>
        <input asp-for="AvailableCopies" class="form-control" />
        <span asp-validation-for="AvailableCopies" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label>Authors</label>
        <div class="border rounded p-2">
            @foreach (var author in Model.AuthorOptions)
            {
                <div class="form-check">
                    <input type="checkbox" class="form-check-input"
                           name="SelectedAuthorIds"
                           value="@author.Value"
                           id="author_@author.Value"
                           checked="@(Model.SelectedAuthorIds.Contains(int.Parse(author.Value)))" />
                    <label class="form-check-label" for="author_@author.Value">@author.Text</label>
                </div>
            }
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}